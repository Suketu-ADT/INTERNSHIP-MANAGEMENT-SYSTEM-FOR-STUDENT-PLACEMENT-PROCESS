# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

DATABASE_URL=sqlite:///database/internship.db

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

MAX_CONTENT_LENGTH_MB=5

ADMIN_EMAIL=admin@college.edu
# Leave blank to auto-generate a strong random admin password on first run
# (it will be printed once to the console). Set your own here to skip that.
ADMIN_PASSWORD=

# True for local development (enables the interactive debugger - never
# expose a debug=True server to a network you don't fully trust). Set to
# False for anything resembling production; SECRET_KEY must then be a real
# random value or the app will refuse to start.
FLASK_DEBUG=True

# Seeds clearly-labelled demo companies/internships on startup (see
# database/seed_demo.py) so the landing page and dashboards have real
# content to show in development/evaluation. Idempotent - safe to leave
# True. Set to False before deploying with real company/student data.
ENABLE_DEMO_SEED=True
